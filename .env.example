# ==========================================
# SecureNotes DevSecOps Environment Variables
# ==========================================
# Copy this file to .env and fill in your actual credentials.
# Note: For GitHub Actions CI/CD, set these under GitHub Repo -> Settings -> Secrets and variables -> Actions.

# ------------------------------------------
# 1. SonarCloud Configuration (Phase 2)
# ------------------------------------------
# Get your token from: https://sonarcloud.io/account/security/
SONAR_TOKEN=your_sonar_token_here
SONAR_PROJECT_KEY=your_sonarcloud_project_key
SONAR_ORG=your_sonarcloud_organization_key

# ------------------------------------------
# 2. Docker Hub Registry (Phase 4)
# ------------------------------------------
# Docker Hub account credentials for publishing validated images
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_personal_access_token

# ------------------------------------------
# 3. NVIDIA NIM API for Remediation Agent (Phase 5)
# ------------------------------------------
# Free developer API key from https://build.nvidia.com
# Model endpoint: https://integrate.api.nvidia.com/v1/chat/completions
# Model identifier: nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_API_KEY=nvapi-your_nvidia_nim_api_key_here
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ------------------------------------------
# 4. Optional Application & Local Testing Settings
# ------------------------------------------
FLASK_ENV=development
FLASK_PORT=5000
# Remediated application auth secret (used when fixed state is active)
APP_SECRET_KEY=secure-runtime-notes-key-2026
